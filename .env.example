# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=miny-ven.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=miny-ven
VITE_FIREBASE_STORAGE_BUCKET=miny-ven.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-ABC123
VITE_PUBLIC_APP_URL=https://miny-ven.vercel.app

# Server-side API (set in Vercel Project Settings -> Environment Variables)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_NAME=Alet V2
