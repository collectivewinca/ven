# Firebase (public web API key for Firestore REST access)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=miny-ven
FIREBASE_STORAGE_BUCKET=miny-ven.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_B64=base64_encoded_service_account_json

# Perplexity API (CTA headlines + research, model: sonar)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# DeepSeek API (60-word summaries, model: deepseek-chat)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Exa (article research + news discovery)
EXA_API_KEY=your_exa_api_key_here

# Brave Search (librarium provider for supplementary discovery)
BRAVE_API_KEY=your_brave_api_key_here

# Gemini image generation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
